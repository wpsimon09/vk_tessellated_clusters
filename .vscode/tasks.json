{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Build",
            "type": "shell",
			"icon": {"color": "terminal.ansiGreen" , "id": "play-circle"},
			"options": {
				"cwd":  "${workspaceFolder}"
			},
			"command": "cmake",
			"args": [
                "--build",
                "--preset",
                "linux-debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}